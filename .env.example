# ── Supabase Edge Function secrets (set with `supabase secrets set`, NEVER commit real values) ──
DEVICE_SECRET_PEPPER=<random 64+ chars: openssl rand -hex 48>   # keys the HMAC of device secrets + enrollment tokens
HEALTHCHECK_SECRET=<random 32+ chars>                            # same value goes in GitHub Actions secret HEALTHCHECK_SECRET
BOOTSTRAP_SECRET=<random 32+ chars>                              # delete after the first admin is created
ALLOWED_ORIGIN=https://<your-github-user>.github.io              # exact dashboard origin(s), comma separated
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into Edge Functions.
# Optional: SB_SECRET_KEY=<new-style secret key> overrides the service role key.

# ── GitHub repository SECRETS (Settings > Secrets and variables > Actions > Secrets) ──
# SUPABASE_FUNCTIONS_URL=https://<ref>.supabase.co/functions/v1
# HEALTHCHECK_SECRET=<same as above>

# ── GitHub repository VARIABLES (public values only) ──
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>

# ── Windows agent (config lives in %ProgramData%\Sentinel\config.json, created by `register`) ──
# Test-only switches (never set on a real laptop): SENTINEL_ALLOW_HTTP=1  SENTINEL_ALLOW_INSECURE_STORE=1  SENTINEL_DATA_DIR=<dir>
